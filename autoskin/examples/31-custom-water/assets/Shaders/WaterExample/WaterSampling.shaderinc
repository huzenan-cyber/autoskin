// Each snapshot has four 258x258 columns and two rows (displacement/cross derivative, other derivatives).
// Periodic one-texel gutters keep bilinear filtering inside each band; no mip chain crosses atlas tiles.
vec4 water_band(sampler2D field, vec2 position, int band, int row) {
    float band_length = patch_length * pow(0.25, float(band));
    vec2 pixel = fract(position / band_length + vec2(0.5)) * 256.0 + vec2(1.5);
    pixel += vec2(float(band) * 258.0, float(row) * 258.0);
    return textureLod(field, pixel / vec2(1032.0, 516.0), 0.0);
}

// The finite mesh is still 128 m with 256 cells; its spacing is independent of the four FFT tile lengths.
vec3 water_displacement(sampler2D field, vec2 position) {
    vec3 result = vec3(0.0);
    for (int band = 0; band < 4; ++band) { result += water_band(field, position, band, 0).xyz; }
    return result;
}

// Explicit triangle interpolation matches the rendered mesh, including its non-periodic boundary vertices.
vec3 water_triangle(sampler2D field, vec2 q, out vec3 dx, out vec3 dz) {
    vec2 grid = (q + vec2(64.0)) * 2.0;
    ivec2 cell = ivec2(floor(grid));
    vec2 f = fract(grid);
    vec2 origin = vec2(cell) * 0.5 - vec2(64.0);
    vec3 a = water_displacement(field, origin + vec2(0.0));
    vec3 b = water_displacement(field, origin + vec2(0.5, 0.0));
    vec3 c = water_displacement(field, origin + vec2(0.0, 0.5));
    vec3 d = water_displacement(field, origin + vec2(0.5));
    vec3 result;
    if (f.x + f.y <= 1.0) {
        result = a + f.x * (b - a) + f.y * (c - a);
        dx = (b.xyz - a.xyz) * 2.0;
        dz = (c.xyz - a.xyz) * 2.0;
    } else {
        result = d + (1.0 - f.y) * (b - d) + (1.0 - f.x) * (c - d);
        dx = (d.xyz - c.xyz) * 2.0;
        dz = (d.xyz - b.xyz) * 2.0;
    }
    return result;
}

// Bounded Newton inversion. Folded, singular, unconverged or out-of-tile points are invalid.
// Residual is measured in world XZ meters; final height comes from the same display triangle.
vec2 water_immersion(sampler2D field, vec3 position) {
    vec2 q = position.xz;
    bool valid = true;
    for (int i = 0; i < 6; ++i) {
        vec3 dx, dz;
        vec3 d = water_triangle(field, q, dx, dz).xyz;
        vec2 error = q + d.xz - position.xz;
        float det = (1.0 + dx.x) * (1.0 + dz.z) - dz.x * dx.z;
        if (det > 0.2) {
            q -= vec2((1.0 + dz.z) * error.x - dz.x * error.y,
                      -dx.z * error.x + (1.0 + dx.x) * error.y) / det;
        } else {
            valid = false;
        }
    }
    vec3 dx, dz;
    vec3 d = water_triangle(field, q, dx, dz).xyz;
    float residual = length(q + d.xz - position.xz);
    valid = valid && residual < 0.00002 && all(lessThanEqual(abs(q), vec2(64.0)));
    return vec2(d.y - position.y, valid ? 1.0 : 0.0);
}
